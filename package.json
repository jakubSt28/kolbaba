{
  "name": "kolbaba",
  "version": "0.1.0",
  "private": true,
  "description": "An email app for you and your AI agent: all your mailboxes in one place, with a built-in MCP server.",
  "license": "AGPL-3.0-or-later",
  "homepage": "https://kolbaba.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jakubSt28/kolbaba.git"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "worker": "tsx watch worker/index.ts",
    "worker:start": "tsx worker/index.ts",
    "vercel-build": "node scripts/migrate.mjs && next build"
  },
