# Kolbaba on your own server. install.sh fills this in; everything else is optional.

# The domain pointing at this server, without https://
DOMAIN=mail.example.com
# Password of the database inside Docker. Nothing outside can reach it. Generate: openssl rand -hex 24
POSTGRES_PASSWORD=
# https = Caddy gets a certificate for DOMAIN. autoupdate = new versions install at night.
COMPOSE_PROFILES=https,autoupdate
# 1 = every 1.x version. A fixed number (1.4.2) stays on that version.
KOLBABA_VERSION=1

# ── At home, through Tailscale instead of a domain (README.md) ────────────────
# COMPOSE_PROFILES=autoupdate
# APP_URL=https://your-computer.your-tailnet.ts.net

# ── Smart features ────────────────────────────────────────────────────────────
# Your own OpenAI key. With it, emails go to OpenAI under your account. Without it, these features stay off.
# OPENAI_API_KEY=

# ── Sign-in codes by email (a passkey needs none of this) ─────────────────────
# SMTP_URL=smtps://you%40seznam.cz:app-password@smtp.seznam.cz:465
# MAIL_FROM=Kolbaba <you@seznam.cz>

# ── Your own Google and Microsoft apps (README.md) ────────────────────────────
# Without Google, Gmail connects with an app password. Outlook needs the Microsoft app.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=

# Tell nobody that this server exists: no check for new versions on GitHub.
# UPDATE_CHECK=off

# Docker's login file, if it isn't ~/.docker/config.json. Only needed for a registry that asks for a login.
# DOCKER_CONFIG_FILE=/root/.docker/config.json
