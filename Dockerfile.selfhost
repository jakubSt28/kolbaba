# The self-hosted Kolbaba (selfhost/README.md): web app and sync worker in one image. Built for every release
# by .github/workflows/selfhost-image.yml.
#   docker build -f Dockerfile.selfhost --build-arg APP_VERSION=1.0.0 -t kolbaba .

# Built on the machine's own architecture: the output is plain JavaScript, so an arm64 image doesn't need
# `next build` to run under emulation.
FROM --platform=$BUILDPLATFORM node:22-slim AS build
WORKDIR /app
ARG APP_VERSION=dev
ENV APP_VERSION=$APP_VERSION BUILD_STANDALONE=1 NEXT_PUBLIC_DATA_MODE=live NEXT_TELEMETRY_DISABLED=1
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts
COPY . .
RUN npx next build
# What the worker runs, without the prototype's sample mail and the maintenance scripts the image doesn't need.
RUN mkdir -p /files/src && cp -r src/server src/lib /files/src/ && cp -r worker drizzle /files/ && rm -f /files/src/lib/mock-data.ts /files/worker/check-insights.ts

# For the image's own architecture, production dependencies only: the worker runs TypeScript with tsx.
FROM node:22-slim AS deps
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts && npm cache clean --force

FROM node:22-slim
WORKDIR /app
ENV NODE_ENV=production SELF_HOSTED=1 NEXT_PUBLIC_DATA_MODE=live NEXT_TELEMETRY_DISABLED=1
COPY --from=deps /app/node_modules ./node_modules
COPY package.json tsconfig.json LICENSE ./
# The web app, without standalone's own copy of node_modules (the full one above has all of it).
COPY --from=build /app/.next/standalone/server.js ./server.js
COPY --from=build /app/.next/standalone/.next ./.next
COPY --from=build /app/.next/static ./.next/static
COPY --from=build /app/public ./public
# The worker and what it runs.
COPY --from=build /files/ ./
COPY scripts/migrate.mjs scripts/selfhost-start.mjs ./scripts/
COPY selfhost/kolbaba-link /usr/local/bin/kolbaba-link
# The install files travel with the image, so installing needs nothing but the registry (selfhost/README.md).
COPY selfhost/docker-compose.yml selfhost/.env.example selfhost/install.sh selfhost/README.md selfhost/README.cs.md ./selfhost/
RUN mkdir -p /data && chown node:node /data && chmod +x /usr/local/bin/kolbaba-link
USER node
VOLUME /data
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s CMD node -e "fetch('http://127.0.0.1:3000/api/version').then(r=>process.exit(r.ok?0:1),()=>process.exit(1))"
CMD ["node", "scripts/selfhost-start.mjs"]
