# Sync worker image. Works on Fly.io, Railway or any Docker host (see CONTRIBUTING.md).
#   docker build -f Dockerfile.worker -t kolbaba-worker .
#   docker run --env-file .env -p 3001:3001 kolbaba-worker
FROM node:22-slim
WORKDIR /app
ENV NODE_ENV=production
COPY package.json package-lock.json ./
# Production dependencies only (tsx runs the TypeScript): dev tools like eslint and drizzle-kit, and their known
# vulnerabilities, stay out of the image.
RUN npm ci --omit=dev --ignore-scripts && npm cache clean --force
COPY tsconfig.json ./
COPY src/server ./src/server
# All of src/lib: the server imports more of it over time (a missing file only shows when the worker starts).
COPY src/lib ./src/lib
COPY worker ./worker
COPY drizzle ./drizzle
EXPOSE 3001
CMD ["npx", "tsx", "worker/index.ts"]
