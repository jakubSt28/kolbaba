# Copy to .env.local (Next.js) / .env (worker, drizzle) and fill in. Never commit the real values.
# Step-by-step guide: CONTRIBUTING.md (development) and selfhost/README.md (your own server).

# ── Mode ──────────────────────────────────────────────────────────────────────
# "mock" = clickable prototype on fake data (no backend needed), "live" = real accounts.
NEXT_PUBLIC_DATA_MODE=mock

# Public URL of the web app (OAuth redirects, tracking pixel, MCP endpoint).
APP_URL=http://localhost:3000

# ── Database (Neon in production, local Postgres in dev) ──────────────────────
DATABASE_URL=postgres://kolbaba:kolbaba@localhost:5432/kolbaba

# ── Secrets ───────────────────────────────────────────────────────────────────
# Master key(s) that wrap mailbox credentials. Generate: openssl rand -base64 32
# Rotation: append a new key ("v1:old,v2:new"); the last one encrypts, all of them decrypt.
CREDENTIALS_KEK=v1:REPLACE_ME
# Signs cookies and app tokens. Generate: openssl rand -base64 32
SESSION_SECRET=REPLACE_ME
# Limits who may create an account: only these emails (comma-separated). Empty = anyone.
SIGNUP_ALLOWLIST=you@example.com
# Who may open /admin, the overview of registered users (comma-separated). Empty = nobody.
ADMIN_EMAILS=you@example.com

# ── Google (sign-in + Gmail API) ──────────────────────────────────────────────
# One OAuth client (type "Web application") in Google Cloud. Publishing status MUST be
# "In production" (unverified is fine for <100 users); "Testing" expires refresh tokens after 7 days.
# Redirect URIs: ${APP_URL}/api/auth/google/callback and ${APP_URL}/api/accounts/google/callback
# Google calendars need the Google Calendar API turned on in the same project (no new redirect URI).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Gmail push: projects/<project>/topics/<topic>; push subscription →
# ${APP_URL}/api/webhooks/gmail?token=${GOOGLE_PUBSUB_VERIFICATION_TOKEN}
GOOGLE_PUBSUB_TOPIC=
GOOGLE_PUBSUB_VERIFICATION_TOKEN=

# ── Microsoft (Outlook.com, Hotmail and Microsoft 365 mailboxes) ───────────────
# An app registration in Microsoft Entra (free), "Any Entra ID tenant + personal Microsoft accounts".
# Redirect URI (Web): ${APP_URL}/api/accounts/microsoft/callback. Delegated permissions: Graph
# openid, email, profile, offline_access, Mail.Send; Office 365 Exchange Online IMAP.AccessAsUser.All
# and SMTP.Send; for the calendar, Graph Calendars.ReadWrite. Empty = Outlook shows as "coming soon".
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# ── Web Push (PWA notifications) ──────────────────────────────────────────────
# Generate: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ── Smart categories (AI) ─────────────────────────────────────────────────────
# Orders, trips, invoices and subscriptions are read by OpenAI (worker only). Without a key they stay off.
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Model for reading them; GPT-6 Luna by default.
INSIGHTS_MODEL=gpt-6-luna
# TypeSafe's Jev sorts mail before OpenAI reads it (worker only). Without a key, rules decide.
TYPESAFE_API_KEY=
# Optional caps (calls per user and day) and everyone's daily AI budget in USD.
# JEV_DAILY_LIMIT=30000
# INSIGHTS_DAILY_LIMIT=3000
# SUMMARY_DAILY_LIMIT=40
# AI_DAILY_BUDGET_USD=10

# ── Kolbaba Plus (Stripe) ─────────────────────────────────────────────────────
# Paying for Plus (smart categories, Awaiting my reply, summaries). Web app only. Without a key the trial and
# gifts from /admin still work, but nobody can subscribe. The product and prices are created on the first checkout.
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
# Optional: signing secret of the webhook endpoint <APP_URL>/api/billing/webhook. Without it, each event is
# fetched from Stripe by its id instead, which proves it just as well.
STRIPE_WEBHOOK_SECRET=

# ── The app's own emails (sign-up codes, feedback) ────────────────────────────
# Resend API key with sending access to the MAIL_FROM domain. Without it (development), codes are printed to the console.
RESEND_API_KEY=
MAIL_FROM=Kolbaba <noreply@example.com>
# Feedback and feature requests from the app go here.
FEEDBACK_TO=you@example.com

# ── Sync worker ───────────────────────────────────────────────────────────────
# Where the always-on worker listens (the web app nudges it after queueing a send).
WORKER_URL=http://localhost:3001
# Shared secret between web app and worker. Generate: openssl rand -base64 32
WORKER_SECRET=REPLACE_ME
